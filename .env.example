POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=credit_risk

# Host is the compose service name "postgres", not localhost, since the API talks
# to it over the internal Docker network.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/credit_risk

# Host-side port the API is published on (container always listens on 8000).
API_PORT=8001
